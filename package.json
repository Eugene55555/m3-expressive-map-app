{
  "name": "m3-expressive-map-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Material 3 Expressive personal map of saved places. Local-first, browser-only.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "build:docs": "npm run build && node scripts/publish-docs.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.5",
    "@material/web": "2.5.0",
    "idb": "8.0.4",
    "leaflet": "1.9.4",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
